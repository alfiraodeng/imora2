# Optional, server-only normalized radar/satellite connector.
# It must return: { "observations": [{ "asset": "T2 - KPP", "observedAt": "ISO-8601", "rainMmPerHour": 1.2, "confidence": 0.8 }] }
# IMORA_NOWCAST_OBSERVATION_URL=https://your-authorized-provider.example/nowcast/indexim
# IMORA_NOWCAST_OBSERVATION_TOKEN=replace-with-server-secret

# Supabase public browser credentials (never place an sb_secret key here).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

